import XCTest
@testable import _00DaysRebuild

class AnnualVisibilityTests: XCTestCase {
    var mockCohortManager: MockCohortManager!
    
    override func setUp() {
        super.setUp()
        mockCohortManager = MockCohortManager()
    }
    
    override func tearDown() {
        mockCohortManager = nil
        super.tearDown()
    }
    
    func testLegacyUserBeforeDeadlineShowsAnnual() {
        // Given
        mockCohortManager.userCohort = .legacyPreUpdate
        let beforeDeadline = Calendar.current.date(from: DateComponents(year: 2025, month: 10, day: 9))!
        
        // When
        let isAnnualVisible = mockCohortManager.annualVisible(now: beforeDeadline)
        
        // Then
        XCTAssertTrue(isAnnualVisible)
    }
    
    func testLegacyUserAfterDeadlineHidesAnnual() {
        // Given
        mockCohortManager.userCohort = .legacyPreUpdate
        let afterDeadline = Calendar.current.date(from: DateComponents(year: 2025, month: 10, day: 11))!
        
        // When
        let isAnnualVisible = mockCohortManager.annualVisible(now: afterDeadline)
        
        // Then
        XCTAssertFalse(isAnnualVisible)
    }
    
    func testNewUserWithinTimerShowsAnnual() {
        // Given
        mockCohortManager.userCohort = .newAfterUpdate
        let now = Date()
        mockCohortManager.firstPaywallAt = now
        
        // When
        let isAnnualVisible = mockCohortManager.annualVisible(now: now)
        
        // Then
        XCTAssertTrue(isAnnualVisible)
    }
    
    func testNewUserAfterTimerHidesAnnual() {
        // Given
        mockCohortManager.userCohort = .newAfterUpdate
        let now = Date()
        mockCohortManager.firstPaywallAt = now.addingTimeInterval(-301) // 5 minutes + 1 second ago
        
        // When
        let isAnnualVisible = mockCohortManager.annualVisible(now: now)
        
        // Then
        XCTAssertFalse(isAnnualVisible)
    }
    
    func testFoundersRibbonVisibleForLegacyUserBeforeDeadline() {
        // Given
        mockCohortManager.userCohort = .legacyPreUpdate
        let beforeDeadline = Calendar.current.date(from: DateComponents(year: 2025, month: 10, day: 9))!
        
        // When
        let isRibbonVisible = mockCohortManager.foundersRibbonVisible(now: beforeDeadline)
        
        // Then
        XCTAssertTrue(isRibbonVisible)
    }
    
    func testFoundersRibbonHiddenForLegacyUserAfterDeadline() {
        // Given
        mockCohortManager.userCohort = .legacyPreUpdate
        let afterDeadline = Calendar.current.date(from: DateComponents(year: 2025, month: 10, day: 11))!
        
        // When
        let isRibbonVisible = mockCohortManager.foundersRibbonVisible(now: afterDeadline)
        
        // Then
        XCTAssertFalse(isRibbonVisible)
    }
    
    func testFoundersRibbonHiddenForNewUser() {
        // Given
        mockCohortManager.userCohort = .newAfterUpdate
        
        // When
        let isRibbonVisible = mockCohortManager.foundersRibbonVisible()
        
        // Then
        XCTAssertFalse(isRibbonVisible)
    }
}

// Mock class for testing
class MockCohortManager {
    var userCohort: UserCohort = .newAfterUpdate
    var firstPaywallAt: Date?
    
    func annualVisible(now: Date = Date()) -> Bool {
        switch userCohort {
        case .legacyPreUpdate:
            // Legacy users see Annual until founders deadline
            let foundersDeadline = Calendar.current.date(from: DateComponents(
                year: 2025,
                month: 10,
                day: 10,
                hour: 23,
                minute: 59,
                second: 59
            )) ?? Date()
            return now < foundersDeadline
            
        case .newAfterUpdate:
            // New users see Annual only within 5-minute window
            guard let firstPaywall = firstPaywallAt else { return true }
            let elapsed = now.timeIntervalSince(firstPaywall)
            return elapsed < 300 // 5 minutes
        }
    }
    
    func foundersRibbonVisible(now: Date = Date()) -> Bool {
        let foundersDeadline = Calendar.current.date(from: DateComponents(
            year: 2025,
            month: 10,
            day: 10,
            hour: 23,
            minute: 59,
            second: 59
        )) ?? Date()
        return userCohort == .legacyPreUpdate && now < foundersDeadline
    }
}
